{
  "name": "@modyfi/vite-plugin-yaml",
  "version": "2.0.0",
  "description": "Import YAML files as JS objects 🔌",
  "type": "module",
  "author": {
    "name": "Tony Ketcham",
    "url": "https://github.com/tonyketcham"
  },
  "license": "MIT",
  "scripts": {
    "dev": "tsup --watch src",
    "example:dev": "pnpm -C example run dev",
    "example:build": "pnpm run build && pnpm -C example run build",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./modules": {
      "types": "./modules.d.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "*.d.ts"
  ],
  "keywords": [
    "vite",
    "vite-plugin",
    "yaml",
    "yml",
    "modyfi",
    "figma"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/figma/vite-plugin-yaml.git"
  },
  "bugs": {
    "url": "https://github.com/figma/vite-plugin-yaml/issues"
  },
  "homepage": "https://github.com/figma/vite-plugin-yaml/tree/main/#readme",
  "peerDependencies": {
    "vite": ">=3.2.7"
  },
  "dependencies": {
    "@rollup/pluginutils": "^5.1.0",
    "js-yaml": "^4.3.1"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@vitest/coverage-v8": "2.1.9",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "2.1.9"
  }
}
